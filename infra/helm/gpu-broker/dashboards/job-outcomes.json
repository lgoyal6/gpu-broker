    "x": 0,
    "y": 16
   },
   "id": 5,
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    }
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "sum by (route) (rate(gpub_http_requests_total{code=\"5xx\"}[5m]))",
     "refId": "A"
    }
   ],
   "title": "API 5xx by route",
   "type": "timeseries"
  }
 ],
