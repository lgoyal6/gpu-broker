{
 "editable": false,
 "panels": [
  {
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ops"
    },
    "overrides": []
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 0
   },
   "id": 1,
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    }
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "sum by (to) (rate(gpub_job_transitions_total{to=~\"SUCCEEDED|FAILED|CANCELLED|EXPIRED\"}[15m]))",
     "refId": "A"
    }
   ],
   "title": "Terminal transitions by state",
   "type": "timeseries"
  },
  {
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ops"
    },
    "overrides": []
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 0
   },
   "id": 2,
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    }
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "sum by (outcome) (rate(gpub_attempt_outcomes_total[15m]))",
     "refId": "A"
    }
   ],
   "title": "Attempt outcomes (LOST/PREEMPTED are retried)",
   "type": "timeseries"
  },
  {
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 8
   },
   "id": 3,
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    }
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "histogram_quantile(0.5, sum by (le) (rate(gpub_job_stage_seconds_bucket{stage=\"submit_to_start\"}[30m])))",
     "refId": "A"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "histogram_quantile(0.99, sum by (le) (rate(gpub_job_stage_seconds_bucket{stage=\"submit_to_start\"}[30m])))",
     "refId": "B"
    }
   ],
   "title": "Submit to start p50 / p99",
   "type": "timeseries"
  },
  {
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 8
   },
   "id": 4,
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    }
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "gpub:submit_availability:ratio_rate5m",
     "refId": "A"
    }
   ],
   "title": "Submit availability (SLO 99.5%)",
   "type": "timeseries"
  },
  {
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ops"
    },
