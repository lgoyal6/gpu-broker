{
 "editable": false,
 "panels": [
  {
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 0
   },
   "id": 1,
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    }
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "max by (pool, worker) (gpub_worker_heartbeat_age_seconds)",
     "refId": "A"
    }
   ],
   "title": "Heartbeat age",
   "type": "timeseries"
  },
  {
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 0
   },
   "id": 2,
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    }
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "sum by (kind) (increase(gpub_stale_reclaims_total[15m]))",
     "refId": "A"
    }
   ],
   "title": "Stale reclaims (leases, reservations)",
   "type": "timeseries"
  },
  {
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ops"
    },
    "overrides": []
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 8
   },
   "id": 3,
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    }
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "sum by (reason) (rate(gpub_artifact_failures_total[15m]))",
     "refId": "A"
    }
   ],
   "title": "Artifact failures",
   "type": "timeseries"
  },
  {
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 8
   },
   "id": 4,
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    }
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "sum by (kind) (increase(gpub_reconciler_repairs_total[1h]))",
     "refId": "A"
    }
   ],
   "title": "Reconciler repairs (should be 0)",
   "type": "timeseries"
  },
  {
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ops"
    },
    "overrides": []
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 16
   },
   "id": 5,
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    }
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "sum by (sqlstate) (rate(gpub_db_tx_retries_total[5m]))",
     "refId": "A"
    }
   ],
   "title": "Database transaction retries",
   "type": "timeseries"
  }
 ],
 "refresh": "30s",
 "schemaVersion": 39,
 "tags": [
  "gpu-broker"
 ],
 "templating": {
  "list": [
   {
    "label": "Prometheus",
    "name": "datasource",
    "query": "prometheus",
    "type": "datasource"
   }
  ]
 },
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "title": "GPU broker: worker health",
 "uid": "gpub-worker-health",
