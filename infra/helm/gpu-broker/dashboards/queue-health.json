{
 "editable": false,
 "panels": [
  {
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 0
   },
   "id": 1,
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    }
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "sum by (tenant) (gpub_queue_depth)",
     "refId": "A"
    }
   ],
   "title": "Queued jobs by tenant",
   "type": "timeseries"
  },
  {
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 0
   },
   "id": 2,
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    }
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "sum by (topic) (gpub_outbox_undelivered)",
     "refId": "A"
    }
   ],
   "title": "Undelivered dispatch events",
   "type": "timeseries"
  },
  {
   "datasource": {
    "type": "prometheus",
