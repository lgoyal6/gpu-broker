     "expr": "sum by (reason) (rate(gpub_reservation_conflicts_total[5m]))",
     "refId": "A"
    }
   ],
   "title": "Reservation conflicts",
   "type": "timeseries"
  },
  {
   "datasource": {
    "type": "prometheus",
